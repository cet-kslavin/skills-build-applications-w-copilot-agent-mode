# Local environment variables for the Octofit Tracker frontend (Vite)
#
# VITE_CODESPACE_NAME must be defined so the app can build the backend API
# base URL as https://${VITE_CODESPACE_NAME}-8000.app.github.dev
#
# In a GitHub Codespace, set this to the value of the CODESPACE_NAME
# environment variable (visible via `echo $CODESPACE_NAME` in the terminal).
# When running locally (outside Codespaces), leave this unset/empty and the
# app will fall back to http://localhost:8000.
VITE_CODESPACE_NAME=
